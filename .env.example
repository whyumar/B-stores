# PakPays merchant API. Create a merchant API key in your PakPays dashboard.
# Add the key in Vercel as PAKPAYS_API_KEY (server-only; never NEXT_PUBLIC_).
PAKPAYS_API_BASE_URL=https://pakpays.vercel.app
PAKPAYS_API_KEY=

# Neon PostgreSQL connection string (server-only; use the pooled connection string).
DATABASE_URL=

# Better Auth secret: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Canonical application URL, used for auth origin validation and checkout redirects.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
